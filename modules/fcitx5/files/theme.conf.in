# sway98 — Windows 98 input method panel.
# Colours follow the same palette as the rest of the theme: button face #c0c0c0,
# shadow #808080, title-bar blue #000080, white text on selection.

[Metadata]
Name=Win98
Version=1.0
Author=sway98
Description=Windows 98 style input panel (Chicago95 palette)
ScaleWithDPI=True

[InputPanel]
NormalColor=#000000
HighlightCandidateColor=#ffffff
HighlightColor=#000080
HighlightBackgroundColor=#000080
PageButtonAlignment=Last Candidate

[InputPanel/TextMargin]
Left=6
Right=6
Top=5
Bottom=5

[InputPanel/ContentMargin]
Left=2
Right=2
Top=2
Bottom=2

[InputPanel/Background]
Color=#c0c0c0
BorderColor=#808080
BorderWidth=2

[InputPanel/Background/Margin]
Left=2
Right=2
Top=2
Bottom=2

[InputPanel/Highlight]
Color=#000080

[InputPanel/Highlight/Margin]
Left=4
Right=4
Top=2
Bottom=2

[InputPanel/PrevPage]
Image=prev.png

[InputPanel/PrevPage/ClickMargin]
Left=5
Right=5
Top=4
Bottom=4

[InputPanel/NextPage]
Image=next.png

[InputPanel/NextPage/ClickMargin]
Left=5
Right=5
Top=4
Bottom=4

[Menu]
NormalColor=#000000
HighlightCandidateColor=#ffffff

[Menu/Background]
Color=#c0c0c0
BorderColor=#808080
BorderWidth=2

[Menu/Background/Margin]
Left=2
Right=2
Top=2
Bottom=2

[Menu/ContentMargin]
Left=2
Right=2
Top=2
Bottom=2

[Menu/CheckBox]
Image=radio.png

[Menu/SubMenu]
Image=arrow.png

[Menu/Highlight]
Color=#000080

[Menu/Highlight/Margin]
Left=5
Right=5
Top=4
Bottom=4

[Menu/Separator]
Color=#808080

[Menu/TextMargin]
Left=5
Right=5
Top=4
Bottom=4
